# Copy this file to .env (or export these as real environment variables)
# before running the backend, if you want live LLM-driven reasoning.
#
# Leave both keys unset to run the agent fully offline with the
# deterministic rule-based planner (zero setup, 100% reproducible --
# this is the default).

# --- Option A: Claude (Anthropic) ---
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5

# --- Option B: Gemini (Google) ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Force a specific planner regardless of which key(s) are set:
#   auto        - prefer Claude if ANTHROPIC_API_KEY is set, else Gemini if
#                 GEMINI_API_KEY is set, else the offline planner (default)
#   gemini      - always use Gemini (fails loudly if GEMINI_API_KEY is unset)
#   llm         - always use Claude (fails loudly if ANTHROPIC_API_KEY is unset)
#   rule_based  - always use the deterministic offline planner
AGENT_MODE=auto
